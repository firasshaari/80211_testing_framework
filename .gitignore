# Secrets / credentials — never commit these
config/testbed.yaml
config/profiles/*.yaml
!config/profiles/example_*.yaml

# AP JSON config files are provided by the user and intentionally tracked.
# configs/ap/**/*.json is NOT ignored.
*.pem
*.key
*.crt
secrets.env
.env

# Logs
*.log

# Lab-specific service addresses and secrets
infra/infra.env

# Generated Allure artefacts (results are produced by a run, reports by the CLI)
allure-results*/
allure-report*/

# Bench PKI: generated locally, never committed.
infra/pki/out/

# Bench Console — per-run results and the bench password hash
runs/
benchd.env
