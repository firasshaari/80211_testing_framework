{
  "_comment": "WPA2 Enterprise (EAP/RADIUS) — Bridge mode — 5 GHz. Variables: SSID, RADIUS_HOST, RADIUS_PORT, RADIUS_SECRET",
  "uuid": 1,
  "radios": [
    {
      "band": "5G",
      "country": "US",
      "channel-mode": "HE",
      "channel": "auto",
      "channel-width": 80,
      "allow-dfs": false
    }
  ],
  "interfaces": [
    {
      "name": "WAN",
      "role": "upstream",
      "services": ["ssh", "lldp", "dhcp-snooping"],
      "ethernet": [{"select-ports": ["WAN*"]}],
      "ipv4": {"addressing": "dynamic"},
      "ssids": [
        {
          "name": "${SSID}",
          "bss-mode": "ap",
          "wifi-bands": ["5G"],
          "services": ["wifi-frames"],
          "encryption": {
            "proto": "wpa2",
            "ieee80211w": "optional"
          },
          "radius": {
            "authentication": {
              "host": "${RADIUS_HOST}",
              "port": "${RADIUS_PORT}",
              "secret": "${RADIUS_SECRET}"
            },
            "accounting": {
              "host": "${RADIUS_HOST}",
              "port": "${RADIUS_ACCT_PORT|1813}",
              "secret": "${RADIUS_SECRET}"
            }
          }
        }
      ]
    },
    {
      "name": "LAN",
      "role": "downstream",
      "services": ["ssh", "lldp", "dhcp-snooping"],
      "ethernet": [{"select-ports": ["LAN*"]}],
      "ipv4": {
        "addressing": "static",
        "subnet": "192.168.1.1/16",
        "dhcp": {"lease-first": 10, "lease-count": 10000, "lease-time": "6h"}
      }
    }
  ],
  "metrics": {
    "statistics": {"interval": 60, "types": ["ssids", "lldp", "clients"]},
    "health": {"interval": 120},
    "wifi-frames": {
      "filters": ["probe", "auth", "assoc", "disassoc", "deauth",
                  "local-deauth", "inactive-deauth", "key-mismatch",
                  "beacon-report", "radar-detected"]
    },
    "dhcp-snooping": {
      "filters": ["ack", "discover", "offer", "request", "solicit", "reply", "renew"]
    }
  },
  "services": {
    "lldp": {"describe": "80211Networks", "location": "Lab"},
    "ssh":  {"port": 22}
  }
}
