# EAP configuration for the bench, wired to the PKI in infra/pki.
#
# The station authenticates with a certificate rather than a password, so the
# enterprise SSIDs in the corpus can be tested with a real identity instead of
# being skipped. PEAP/MSCHAPv2 is kept alongside so the password accounts in
# `authorize` still work — an AP config asking for either finds a server that
# answers it.
#
# Certificates come from infra/pki/make-pki.sh and are mounted read-only into
# the container. They are bench-local and disposable: regenerating them is a
# single command, and nothing outside this lab trusts them.
eap {
	default_eap_type = tls
	timer_expire     = 60
	max_sessions     = 256

	tls-config tls-common {
		private_key_file = /etc/freeradius/3.0/certs/server.key
		certificate_file = /etc/freeradius/3.0/certs/server.pem
		ca_file          = /etc/freeradius/3.0/certs/ca.pem
		dh_file          = /etc/freeradius/3.0/certs/dh

		# No password on the bench key: it is generated locally, lives only
		# here, and a password would have to be stored beside it anyway.
		private_key_password =

		cipher_list      = "DEFAULT:@SECLEVEL=1"
		tls_min_version  = "1.2"
		tls_max_version  = "1.3"

		cache {
			enable = no
		}
		verify {
		}
	}

	# Certificate-based. The client must present a certificate signed by our
	# CA; anything else is rejected, which is the property under test.
	tls {
		tls = tls-common
	}

	# Retained so the password accounts keep working for AP configs that ask
	# for PEAP rather than TLS.
	peap {
		tls                    = tls-common
		default_eap_type       = mschapv2
		copy_request_to_tunnel = yes
		use_tunneled_reply     = yes
		virtual_server         = "inner-tunnel"
	}

	ttls {
		tls                    = tls-common
		default_eap_type       = mschapv2
		copy_request_to_tunnel = yes
		use_tunneled_reply     = yes
		virtual_server         = "inner-tunnel"
	}

	mschapv2 {
	}
}
