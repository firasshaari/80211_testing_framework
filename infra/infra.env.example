# Copy to infra/infra.env and adjust, then: make infra-up
#
# RADIUS runs with host networking on the station host, so the AP reaches it at
# the station's own address. Nothing else is needed: internet connectivity is
# measured with librespeed-cli against public servers, so there is no local
# traffic peer to isolate.

# Shared secret the AP uses to talk to RADIUS.
RADIUS_SECRET=testing123
